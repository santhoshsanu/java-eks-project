# ── IDE / Editors ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# ── Java / Gradle ──────────────────────────────────────────────────────────────
backend/build/
backend/.gradle/
user-service/build/
user-service/.gradle/
order-service/build/
order-service/.gradle/
*.class
*.log
*.jar
!backend/gradle/wrapper/gradle-wrapper.jar
!user-service/gradle/wrapper/gradle-wrapper.jar
!order-service/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
hs_err_pid*

# ── Node / React ───────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.env
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Terraform ──────────────────────────────────────────────────────────────────
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl
terraform/tfplan
terraform/*.tfvars.backup
terraform/alb-iam-policy.json   # downloaded at runtime, not needed in Git

# ── AWS / Keys ─────────────────────────────────────────────────────────────────
*.pem
*.ppk
.aws/
alb-iam-policy.json             # root level — downloaded at runtime
terraform/alb-iam-policy.json   # terraform folder copy — not needed
# NOTE: iam/alb-controller-policy.json is intentionally committed — used by Terraform

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/
